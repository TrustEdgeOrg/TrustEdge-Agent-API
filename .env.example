TRUSTEDGE_AGENT_LISTEN=:8080
TRUSTEDGE_AGENT_DATA_DIR=data
TRUSTEDGE_AGENT_ENROLL_TOKEN=
# Set to 1 in production (requires enroll token)
# TRUSTEDGE_AGENT_PRODUCTION=1
# Override disk writes: TRUSTEDGE_AGENT_PERSIST_FILES=0|1
# Optional: publish ingested events to Kafka/Redpanda (unset = disabled)
# KAFKA_BROKERS=redpanda:9092
# KAFKA_TOPIC=trustedge.agent.events

# Optional: live twin in Redis (fail-open if unset/unreachable)
# REDIS_URL=redis://redis:6379/0

# Upsert registered agents into TrustEdge Postgres (fail-open if unset/unreachable)
# TRUSTEDGE_BACKEND_URL=http://backend:8000
# TRUSTEDGE_INGEST_TOKEN=  # same bearer as TrustEdge TRUSTEDGE_INGEST_TOKEN
# TRUSTEDGE_UPSERT_TIMEOUT_SEC=5
